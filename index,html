const norm = t => t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^\p{L}\p{N} ]/gu, "").trim();
const safeUrl = u => /^https?:\/\//i.test(u) || /^[\w\-.\/]+\.html?$/i.test(u);
const isBlocked = () => { try { return localStorage.getItem(BLOCK_KEY) === "1"; } catch (e) { return false; } };

function deadlineDate() { const d = CONFIG.offer.deadline ? new Date(CONFIG.offer.deadline) : null; return d && !isNaN(d) && d > new Date() ? d : null; }
function slotsLeft() { const n = CONFIG.offer.slots; return typeof n === "number" && n > 0 ? n : null; }
/* "if": deadline/slots vêm de offer; qualquer outro nome vem de real (vazio = esconde) */
const cond = k => k === "deadline" ? !!deadlineDate() : k === "slots" ? slotsLeft() !== null : !!String(CONFIG.real[k] || "").trim();
function fmtPrazo() {
  const d = deadlineDate(); if (!d) return "";
  return d.toLocaleDateString("pt-BR", { day: "2-digit", month: "2-digit" }) + " às " + d.toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
}
const interp = t => String(t).replace(/\{\{([\w.]+)\}\}/g, (_, k) => {
  if (k === "prazo") return fmtPrazo();
  if (k === "vagas") return slotsLeft() ?? "";
  if (/^(checkout|prices|real)\./.test(k)) return lookup(CONFIG, k) ?? "";
  return state.vars[k] ?? "";
});

function pickNicknames() {
  const a = CONFIG.apelidos.slice(); const i = Math.floor(Math.random() * a.length);
  const first = a.splice(i, 1)[0] || "";
  const second = a.length ? a[Math.floor(Math.random() * a.length)] : first;
  return { apelido: first, apelido2: second };
}

function resolveSrc(s) {
  if (s === "demo:tone") return toneUrl();
  if (s.startsWith("demo:img:")) {
    const [, , label, color] = s.split(":");
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='600' height='320'><rect width='600' height='320' fill='${color}'/><text x='300' y='190' font-family='sans-serif' font-size='48' fill='#fff' text-anchor='middle'>${label.replace(/[<&]/g, "")}</text></svg>`;
    return "data:image/svg+xml," + encodeURIComponent(svg);
  }
  return s;
}
function toneUrl() {
  if (toneUrl.u) return toneUrl.u;
  const sr = 8000, notes = [523, 659, 784], d = .5, n = sr * d * notes.length, b = new DataView(new ArrayBuffer(44 + n * 2));
  const w = (o, s) => [...s].forEach((c, i) => b.setUint8(o + i, c.charCodeAt(0)));
  w(0, "RIFF"); b.setUint32(4, 36 + n * 2, true); w(8, "WAVEfmt "); b.setUint32(16, 16, true); b.setUint16(20, 1, true); b.setUint16(22, 1, true);
  b.setUint32(24, sr, true); b.setUint32(28, sr * 2, true); b.setUint16(32, 2, true); b.setUint16(34, 16, true); w(36, "data"); b.setUint32(40, n * 2, true);
  for (let i = 0; i < n; i++) {
    const f = notes[Math.floor(i / (sr * d))], env = Math.min(1, (sr * d - (i % (sr * d))) / 800);
    b.setInt16(44 + i * 2, Math.sin(2 * Math.PI * f * i / sr) * 9000 * env, true);
  }
  return toneUrl.u = URL.createObjectURL(new Blob([b], { type: "audio/wav" }));
}
function defaultAvatar() {
  const ini = (CONFIG.profile.name.trim()[0] || "A").toUpperCase();
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='96' height='96'><rect width='96' height='96' fill='${CONFIG.colors.accent}'/><text x='48' y='64' font-family='sans-serif' font-size='46' font-weight='700' fill='#fff' text-anchor='middle'>${ini.replace(/[<&]/g, "")}</text></svg>`;
  return "data:image/svg+xml," + encodeURIComponent(svg);
}

const blank = () => ({ v: 3, entries: [], vars: pickNicknames(), current: null, idx: 0, waiting: null, nudged: {} });
function save() { try { localStorage.setItem(CONFIG.storageKey, JSON.stringify(state)); } catch (e) {} }
function load() {
  try { const s = JSON.parse(localStorage.getItem(CONFIG.storageKey)); if (s && s.v === 3 && Array.isArray(s.entries) && s.entries.length) return s; } catch (e) {}
  return null;
}

const nearBottom = () => chat.scrollHeight - chat.scrollTop - chat.clientHeight < 100;
const toEnd = (instant) => chat.scrollTo({ top: chat.scrollHeight, behavior: instant || reduce ? "auto" : "smooth" });
function push(node, force) {
  const was = nearBottom();
  chat.append(node);
  if (was || force) toEnd(); else downBtn.hidden = false;
}
chat.addEventListener("scroll", () => { if (nearBottom()) downBtn.hidden = true; }, { passive: true });
downBtn.onclick = () => { toEnd(); downBtn.hidden = true; };

function render(e, instant) {
  const m = e.m, row = el("div", "row " + e.who);
  const last = [...chat.querySelectorAll(".row")].pop();
  if (!last || !last.classList.contains(e.who)) row.classList.add("tail");
  if (instant) row.style.animation = "none";
  const b = el("div", "bubble");
  const type = m.type || "text";
  if (type === "image") {
    const i = el("img", "pic"); i.src = resolveSrc(m.src); i.alt = m.alt || "Imagem"; i.loading = "lazy"; b.append(i);
    if (m.caption) { const p = el("p"); p.textContent = m.caption; b.append(p); }
  } else if (type === "audio") {
    const a = el("audio"); a.controls = true; a.preload = "none"; a.src = resolveSrc(m.src); a.setAttribute("aria-label", "Mensagem de áudio"); b.append(a);
  } else if (type === "card") {
    b.classList.add("card"); if (m.hot) b.classList.add("hot");
    if (m.badge) { const g = el("span", "badge"); g.textContent = m.badge; b.append(g); }
    if (m.image) { const i = el("img", "pic"); i.src = resolveSrc(m.image); i.alt = m.alt || m.title || ""; i.loading = "lazy"; b.append(i); }
    const h = el("h3"); h.textContent = m.title || ""; b.append(h);
    if (m.price) {
      const pr = el("p", "price");
      if (m.old) { const s = el("s"); s.textContent = m.old; pr.append(s); }
      pr.append(document.createTextNode(m.price)); b.append(pr);
    }
    const p = el("p"); p.textContent = m.text || ""; b.append(p);
    if (m.button) {
      const btn = el("button", "cbtn"); btn.type = "button"; btn.textContent = m.button.label; btn.disabled = true; btn.dataset.step = e.step;
      btn.onclick = () => pick({ label: m.button.label, next: m.button.next, url: m.button.url });
      b.append(btn);
    }
  } else {
    const p = el("p"); p.textContent = m.text; b.append(p);
  }
  const meta = el("div", "meta"), t = el("span"); t.textContent = e.t; meta.append(t);
  if (e.who === "user") {
    const k = el("span", "ticks"); k.innerHTML = CHECKS; k.setAttribute("aria-label", "Enviada"); meta.append(k);
    if (instant) k.classList.add("d", "r");
    else { setTimeout(() => k.classList.add("d"), 400); setTimeout(() => k.classList.add("r"), 1100); }
  }
  b.append(meta); row.append(b);
  return row;
}
function addEntry(who, m, stepId, force) {
  const e = { who, m, step: stepId, t: clock() };
  state.entries.push(e); push(render(e), force); save();
}
function botMsg(raw, stepId) {
  const m = JSON.parse(JSON.stringify(raw));
  ["text", "title", "alt", "caption", "price", "old", "src"].forEach(k => { if (m[k]) m[k] = interp(m[k]); });
  if (m.button && m.button.url) m.button.url = interp(m.button.url);
  addEntry("bot", m, stepId);
}
const userSay = text => addEntry("user", { type: "text", text }, null, true);

async function typeFor(ms) {
  const r = el("div", "row bot tail typing"); r.innerHTML = "<div class='bubble'><i></i><i></i><i></i></div>";
  r.setAttribute("aria-label", CONFIG.texts.typing);
  const last = [...chat.querySelectorAll(".row")].pop();
  if (last && last.classList.contains("bot")) r.classList.remove("tail");
  push(r); statusEl.textContent = CONFIG.texts.typing;
  await sleep(ms); r.remove(); statusEl.textContent = CONFIG.profile.status;
}
const delayFor = m => m.delay ?? (m.type === "card" ? 900 : m.type === "audio" || m.type === "image" ? 1200 : Math.min(CONFIG.typing.max, CONFIG.typing.base + CONFIG.typing.perChar * (m.text ? interp(m.text).length : 0)));

function lock() { sendBtn.disabled = busy || !state.waiting; }
function setBusy(v) { busy = v; lock(); }

function clearQuick() { chat.querySelectorAll(".quick").forEach(q => q.remove()); }
function enableCards(id) { chat.querySelectorAll(".cbtn").forEach(b => b.disabled = b.dataset.step !== id); }

/* lembrete único se o cliente ficar parado na etapa */
function armNudge(step) {
  clearTimeout(nudgeT);
  if (!step.nudge || (state.nudged || {})[step.id]) return;
  const my = runId;
  nudgeT = setTimeout(async () => {
    if (my !== runId || busy || state.waiting !== step.id) return;
    state.nudged = state.nudged || {}; state.nudged[step.id] = 1; setBusy(true);
    for (const m of step.nudge.filter(x => !x.if || cond(x.if))) {
      await typeFor(delayFor(m)); if (my !== runId) return;
      clearQuick(); botMsg(m, step.id);
    }
    showQuick(step); setBusy(false);
  }, step.nudgeAfter || 45000);
}

function showQuick(step) {
  clearQuick(); enableCards(step.id); armNudge(step);
  input.placeholder = step.placeholder || CONFIG.texts.placeholder;
  if (!step.options || !step.options.length) return;
  const q = el("div", "quick"); q.setAttribute("role", "group"); q.setAttribute("aria-label", "Opções de resposta");
  step.options.forEach(o => {
    const b = el("button", "qbtn"); b.type = "button"; b.textContent = o.label;
    if (o.url && !o.next) b.insertAdjacentHTML("beforeend", ICON_EXT);
    b.onclick = () => pick(o); q.append(b);
  });
  push(q);
}

async function runStep(id, start = 0) {
  const my = runId, step = steps[id];
  if (!step) { console.error("Etapa inexistente:", id); setBusy(false); return; }
  clearTimeout(nudgeT);
  setBusy(true); state.current = id; state.waiting = null; clearQuick(); enableCards(null);
  const msgs = (step.messages || []).filter(m => !m.if || cond(m.if));
  for (let i = start; i < msgs.length; i++) {
    state.idx = i; save();
    await typeFor(delayFor(msgs[i]));
    if (my !== runId) return;
    botMsg(msgs[i], id); state.idx = i + 1; save();
  }
  if (my !== runId) return;
  state.idx = msgs.length;
  if (step.type === "message") {
    if (step.next) return runStep(step.next);
    save(); setBusy(false); return;
  }
  state.waiting = id; save(); showQuick(step); setBusy(false);
  if (step.type === "input") input.focus({ preventScroll: true });
}

function pick(opt, typed) {
  if (busy || !state.waiting) return;
  if (opt.action === "restart") { reset(false); return; }
  clearTimeout(nudgeT);
  if (opt.block) { try { localStorage.setItem(BLOCK_KEY, "1"); } catch (e) {} }
  if (opt.set) Object.assign(state.vars, opt.set);
  const url = opt.url ? interp(opt.url) : "";
  if (url && safeUrl(url)) window.open(url, "_blank", "noopener,noreferrer");
  if (!opt.next) { if (typed) botNote(CONFIG.texts.done); else if (url) { userSay(opt.label); save(); armNudge(steps[state.waiting]); } return; }
  setBusy(true); state.waiting = null; save();
  clearQuick(); enableCards(null);
  if (!typed) userSay(opt.label);
  const my = runId; setTimeout(() => { if (my === runId) runStep(opt.next); }, 450);
}

async function botNote(text) {
  const my = runId; setBusy(true);
  text = interp(text);
  await typeFor(Math.min(CONFIG.typing.max, CONFIG.typing.base + CONFIG.typing.perChar * text.length));
  if (my !== runId) return;
  clearQuick(); botMsg({ text }, state.waiting); showQuick(steps[state.waiting]); setBusy(false);
}

function cleanName(t) {
  t = t.trim().replace(/^(meu nome é|meu nome e|me chamo|me chama|eu sou o|eu sou a|eu sou|sou o|sou a|sou)\s+/i, "");
  const w = (t.split(/\s+/)[0] || "").replace(/[^\p{L}'\-]/gu, "").slice(0, 30);
  return w.length >= 2 ? w[0].toLocaleUpperCase("pt-BR") + w.slice(1) : "";
}

function submit() {
  const text = input.value.trim();
  if (!text || busy || !state.waiting) return;
  const step = steps[state.waiting];
  input.value = "";
  if (step.type === "input") {
    let v = text.slice(0, 200);
    if (step.validate === "name") {
      v = cleanName(text);
      if (!v) { setBusy(true); userSay(text); botNote(CONFIG.texts.invalidName); return; }
    }
    setBusy(true); state.vars[step.variable] = v; state.waiting = null; save();
    clearQuick(); userSay(text);
    const my = runId; setTimeout(() => { if (my === runId) runStep(step.next); }, 450);
    return;
  }
  const n = norm(text);
  const opt = (step.options || []).find(o => { const l = norm(o.label); return l && (l === n || (n.length >= 3 && (l.includes(n) || n.includes(l)))); });
  userSay(text);
  if (opt) { pick(opt, true); return; }
  setBusy(true); botNote(CONFIG.texts.notUnderstood);
}
form.addEventListener("submit", ev => { ev.preventDefault(); submit(); });

function mount() {
  chat.textContent = "";
  const p = el("div", "pill"); p.textContent = CONFIG.texts.disclaimer; chat.append(p);
}
function start() {
  state = blank(); mount(); input.placeholder = CONFIG.texts.placeholder; lock();
  runStep(isBlocked() ? CONFIG.blockedStep : CONFIG.start);
}
function restore(saved) {
  state = saved; mount();
  state.entries.forEach(e => chat.append(render(e, true)));
  toEnd(true);
  if (state.waiting && steps[state.waiting]) { showQuick(steps[state.waiting]); setBusy(false); }
  else if (state.current) runStep(state.current, state.idx || 0);
  else start();
}
function reset(ask) {
  if (ask && state.entries.length && !confirm(CONFIG.texts.confirmRestart)) return;
  runId++; busy = false; clearTimeout(nudgeT); statusEl.textContent = CONFIG.profile.status; downBtn.hidden = true;
  try { localStorage.removeItem(CONFIG.storageKey); } catch (e) {}
  input.value = ""; start();
}
$("#restart").onclick = () => reset(true);

function fit() {
  const was = nearBottom(), vv = window.visualViewport;
  document.documentElement.style.setProperty("--app-h", (vv ? vv.height : innerHeight) + "px");
  window.scrollTo(0, 0); if (was) toEnd(true);
}
if (window.visualViewport) { visualViewport.addEventListener("resize", fit); visualViewport.addEventListener("scroll", () => window.scrollTo(0, 0)); }
addEventListener("resize", fit);

(function init() {
  const c = CONFIG.colors, r = document.documentElement.style;
  r.setProperty("--header", c.header); r.setProperty("--accent", c.accent); r.setProperty("--user", c.userBubble);
  r.setProperty("--bot", c.botBubble); r.setProperty("--bg", c.background); r.setProperty("--text", c.text);
  document.title = CONFIG.profile.name + " · " + CONFIG.profile.status;
  $("#name").textContent = CONFIG.profile.name; statusEl.textContent = CONFIG.profile.status;
  const av = $("#avatar"); av.src = CONFIG.profile.photo || defaultAvatar(); av.onerror = () => { av.onerror = null; av.src = defaultAvatar(); };
  $("#restart").title = CONFIG.texts.restart; $("#restart").setAttribute("aria-label", CONFIG.texts.restart);
  downBtn.textContent = CONFIG.texts.newMsg;
  fit();
  state = blank();
  const saved = isBlocked() ? null : load();
  saved ? restore(saved) : start();
})();
</script>
</body>
</html>
