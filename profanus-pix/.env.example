# Copie para .env. Mantenha as credenciais apenas no servidor.
PROFANUS_API_KEY=COLOQUE_SUA_API_KEY_AQUI
# Origem EXATA, sem barra final. Em produção use HTTPS.
PUBLIC_URL=http://localhost:8080
PIX_AMOUNT=20.00
PIX_EXPIRATION=1800
PORT=8080
